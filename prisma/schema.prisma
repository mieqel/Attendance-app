generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A patient enrolled in one or more classes.
// Appearance is built from three simple choices (skin tone, hair style, hair
// color) rather than a fixed emoji set, so patients can make their avatar
// look like them while staying anonymous to other patients.
model Patient {
  id        String   @id @default(cuid())
  name      String
  skinTone  String   @default("medium")
  hairStyle String   @default("short")
  hairColor String   @default("brown")
  active    Boolean  @default(true)
  // "actief" | "pauze" | "inactief" — replaces the old active/inactive-only
  // toggle. "pauze" is for injury recovery, holidays, etc: still shown on
  // the kiosk if they show up, but excluded from the "hasn't been in a
  // while" alert since their absence is expected.
  status    String   @default("actief")
  // Optional end date for "pauze". When it passes, the patient is switched
  // back to "actief" automatically, and the "hasn't been in a while" clock
  // starts counting from this date instead of from their last check-in.
  // Kept after the pause ends so that clock keeps working.
  pauseUntil DateTime?
  createdAt DateTime @default(now())

  classes  PatientClass[]
  checkIns CheckIn[]
  absences Absence[]
}

// The fixed weekly schedule, e.g. "Monday 16:00-17:00"
// dayOfWeek: 0 = Sunday ... 6 = Saturday (JS convention)
model ClassTemplate {
  id        String   @id @default(cuid())
  label     String
  dayOfWeek Int
  startTime String // "HH:MM" 24h
  endTime   String // "HH:MM" 24h
  createdAt DateTime @default(now())

  patients PatientClass[]
  sessions ClassSession[]
}

// Join table: which patients belong to which recurring class
model PatientClass {
  patientId       String
  classTemplateId String

  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  classTemplate ClassTemplate @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)

  @@id([patientId, classTemplateId])
}

// One real occurrence of a class on a specific date.
// Created lazily the first time someone checks in for that date/template.
model ClassSession {
  id              String   @id @default(cuid())
  classTemplateId String
  date            String   // "YYYY-MM-DD" in Europe/Amsterdam local time, e.g. "2026-07-15"

  classTemplate ClassTemplate @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)
  checkIns      CheckIn[]

  @@unique([classTemplateId, date])
}

// A single check-in: this patient was present at this session
model CheckIn {
  id             String   @id @default(cuid())
  patientId      String
  classSessionId String
  checkedInAt    DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([patientId, classSessionId])
}

// An excused absence on a specific day: the clinic knows why they weren't
// there (ziek / vakantie / afgemeld). Excused days reset the "Aandacht
// nodig" clock, so only unexplained absences end up on that list.
model Absence {
  id              String   @id @default(cuid())
  patientId       String
  date            String   // "YYYY-MM-DD", Amsterdam local
  reason          String   // "ziek" | "vakantie" | "afgemeld"
  classTemplateId String?
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, date])
}
